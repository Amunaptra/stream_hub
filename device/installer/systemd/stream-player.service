[Unit]
Description=Stream Hub HLS player
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
ConditionPathExists=!/etc/stream-hub/golden-image

[Service]
Type=simple
User=odroid
Group=stream-hub
WorkingDirectory=/opt/stream-hub-device
Environment=STREAM_HUB_PLAYLIST=/etc/stream-hub/playlist.json
Environment=STREAM_HUB_RUNTIME_DIR=/run/stream-hub
Environment=STREAM_HUB_LOG_LEVEL=INFO
Environment=STREAM_HUB_CROSSFADE_MS=400
Environment=STREAM_HUB_PREROLL_TIMEOUT=8
Environment=STREAM_HUB_FRAMEBUFFER=/dev/fb0
Environment=XDG_RUNTIME_DIR=/run/stream-hub
RuntimeDirectory=stream-hub
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
ExecStart=/usr/bin/python3 /opt/stream-hub-device/device/player/stream_player.py
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/stream-hub

[Install]
WantedBy=multi-user.target
